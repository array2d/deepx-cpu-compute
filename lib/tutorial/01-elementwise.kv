// CPU tensor 元素级运算（myrwircapstable: deepx/miaobyte·add/sub/mul/div）
// 运行：DEEPX_DUMP=1 deepx-cpu-compute lib/tutorial/01-elementwise.kv
// 期望输出：
//   [deepx-cpu] deepx/miaobyte·add -> 5 5 5 5
//   [deepx-cpu] deepx/miaobyte·sub -> -3 -1 1 3
//   [deepx-cpu] deepx/miaobyte·mul -> 4 6 6 4
//   [deepx-cpu] deepx/miaobyte·div -> 0.25 0.666667 1.5 4
rwfunc test() -> () {
	a:[]float64 = [1.0, 2.0, 3.0, 4.0]
	b:[]float64 = [4.0, 3.0, 2.0, 1.0]
	deepx/miaobyte·add(a, b) -> s1
	deepx/miaobyte·sub(a, b) -> s2
	deepx/miaobyte·mul(a, b) -> s3
	deepx/miaobyte·div(a, b) -> s4
}
