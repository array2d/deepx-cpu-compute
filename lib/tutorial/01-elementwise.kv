// CPU tensor 逐元素运算（myrwircaps: tensor.add/sub/mul/div）
// 运行：DEEPX_DUMP=1 deepx-cpu-compute lib/tutorial/01-elementwise.kv
// 期望输出:
//   [deepx-cpu] tensor.add -> 5 5 5 5
//   [deepx-cpu] tensor.sub -> -3 -1 1 3
//   [deepx-cpu] tensor.mul -> 4 6 6 4
//   [deepx-cpu] tensor.div -> 0.25 0.666667 1.5 4
rwfunc test() -> () {
	a:[]float64 = [1.0, 2.0, 3.0, 4.0]
	b:[]float64 = [4.0, 3.0, 2.0, 1.0]
	tensor.add(a, b) -> s1
	tensor.sub(a, b) -> s2
	tensor.mul(a, b) -> s3
	tensor.div(a, b) -> s4
}
